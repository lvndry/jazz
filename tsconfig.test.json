{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/core/*": ["./packages/core/src/*"],
      "@/adapters/*": ["./packages/adapters/src/*"],
      "@/cli/*": ["./packages/cli/src/*"]
    }
  },
  "include": [
    "test-preload.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "scripts/**/*.test.ts",
    "evals/**/*.test.ts",
    "bench/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
