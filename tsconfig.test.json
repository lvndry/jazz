{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/test",
    "emitDeclarationOnly": true,
    "types": ["bun"],
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": ".tsbuildinfo.test"
  },
  "include": [
    "test-preload.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "evals/**/*.test.ts",
    "integrations/**/*.test.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "./tsconfig.app.json" }]
}
