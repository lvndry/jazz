{
  "name": "jazz-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "tokens": "bun run scripts/generate-tokens.ts",
    "build": "bun run tokens && astro build && bun run validate-jsonld && pagefind --site dist",
    "validate-jsonld": "bun run scripts/validate-jsonld.ts",
    "check-links": "bun run scripts/check-links.ts",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "mermaid": "^11.17.0"
  },
  "devDependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2"
  }
}
