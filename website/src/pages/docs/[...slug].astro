---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import {
  buildSidebar,
  descriptionOf,
  prevNextFor,
  routeFor,
  routeSlugFor,
  SECTIONS,
  titleOf,
} from "../../lib/docs";
import type { DocsEntry } from "../../lib/docs";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: routeSlugFor(entry.id) || undefined },
    props: { entry },
  }));
}

interface Props {
  entry: DocsEntry;
}

const { entry } = Astro.props;
const entries = await getCollection("docs");
const sidebar = buildSidebar(entries);
const title = titleOf(entry);
const description = descriptionOf(entry);
const sectionDir = entry.id.split("/")[0] ?? "";
const sectionLabel =
  sectionDir === "" || sectionDir === "index"
    ? undefined
    : (SECTIONS.find((section) => section.dir === sectionDir)?.label ?? undefined);
const { Content } = await render(entry);
---

<Docs
  title={title}
  description={description}
  sidebar={sidebar}
  currentRoute={routeFor(entry.id)}
  prevNext={prevNextFor(sidebar, entry.id)}
  rawMdPath={`/docs/${entry.id}.md`}
  image={`/og/${entry.id}.png`}
  sectionLabel={sectionLabel}
  sectionRoute={sectionDir === "" || sectionDir === "index" ? undefined : `/docs/${sectionDir}`}
>
  <Content />
</Docs>
