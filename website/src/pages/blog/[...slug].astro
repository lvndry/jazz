---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Blog from "../../layouts/Blog.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatted = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Blog
  title={`${post.data.title} — Jazz blog`}
  description={post.data.description}
  image={`/og/blog/${post.id}.png`}
>
  <article class="post">
    <p class="eyebrow mono">▞ jazz blog</p>
    <h1>{post.data.title}</h1>
    <p class="meta mono">
      <time datetime={post.data.date.toISOString()}>{formatted}</time> · by lvndry
    </p>
    <Content />
  </article>
  <p class="backline mono"><a href="/blog">← all posts</a> · <a href="/rss.xml">rss</a></p>
</Blog>

<style>
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--jz-primary);
    margin-bottom: 14px;
  }
  .meta {
    font-size: 12px;
    color: var(--jz-muted);
    margin: 6px 0 2.2rem;
  }
  .backline {
    margin-top: 4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--jz-border);
    font-size: 12.5px;
  }
  .backline a {
    color: var(--jz-accent-dim);
    text-decoration: none;
  }
  .backline a:hover {
    color: var(--jz-primary);
  }
</style>
