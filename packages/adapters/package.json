{
  "name": "@jazz/adapters",
  "version": "0.15.6",
  "private": true,
  "description": "Service adapters implementing @jazz/core's interfaces: LLM providers, storage, secrets, peers, telemetry.",
  "type": "module",
  "exports": {
    "./notification": "./src/notification/index.ts",
    "./llm/reasoning": "./src/llm/reasoning/index.ts",
    "./llm/chatgpt": "./src/llm/chatgpt/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "dependencies": {
    "@jazz/core": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "hono": "^4.13.5",
    "nanotar": "^0.3.0",
    "plist": "^5.0.0"
  }
}
