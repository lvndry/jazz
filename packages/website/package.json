{
  "name": "@jazz/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "tokens": "bun run scripts/generate-tokens.ts",
    "brand": "bun run scripts/export-brand.ts",
    "build": "bun run tokens && cd ../.. && bun run scripts/build-plugin-catalog.ts && cd packages/website && astro build && bun run validate-jsonld && pagefind --site dist",
    "validate-jsonld": "bun run scripts/validate-jsonld.ts",
    "check-links": "bun run scripts/check-links.ts",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@jazz/cli": "workspace:*",
    "@jazz/core": "workspace:*",
    "astro": "^7.4.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2"
  }
}
