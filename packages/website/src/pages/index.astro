---
import AsksFirst from "../components/AsksFirst.astro";
import Cookbook from "../components/Cookbook.astro";
import Hero from "../components/Hero.astro";
import InstallCta from "../components/InstallCta.astro";
import InstallStrip from "../components/InstallStrip.astro";
import SessionStage from "../components/SessionStage.astro";
import Surfaces from "../components/Surfaces.astro";
import Ticker from "../components/Ticker.astro";
import UnderTheHood from "../components/UnderTheHood.astro";
import Base from "../layouts/Base.astro";

const FAQ = [
  {
    question: "What is Jazz?",
    answer:
      "Jazz is a free, open-source AI agent harness. It runs a general-purpose AI agent on your own machine that can use a terminal, read and write files, search the web, send messages, and work on a schedule — asking for your approval before anything consequential.",
  },
  {
    question: "Is Jazz free?",
    answer:
      "Yes. Jazz is MIT-licensed open source and costs nothing. You pay only your chosen LLM provider for tokens — or nothing at all if you run local models through Ollama or llama.cpp.",
  },
  {
    question: "Does Jazz run locally or offline?",
    answer:
      "Yes. Jazz runs entirely on your machine and supports fully local models via Ollama and llama.cpp, so it works airgapped: no API keys, no telemetry leaving your disk, and an offline mode that disables every outbound request.",
  },
  {
    question: "Which LLM providers does Jazz support?",
    answer:
      "Eighteen providers behind one interface, including Anthropic, OpenAI, Google, Mistral, Groq, OpenRouter, and fully local options like Ollama and llama.cpp. Switch models without changing anything else about your agent.",
  },
  {
    question: "How is Jazz different from a chatbot CLI?",
    answer:
      "A chatbot answers one prompt and stops. Jazz is an agent runtime: the same agent works in your terminal, in Telegram or Discord, in CI pipelines, and on cron schedules — unattended, with per-run approval policies controlling what it may do on its own.",
  },
  {
    question: "Is it safe to let an agent run on my machine?",
    answer:
      "Jazz treats safety as load-bearing: every tool declares an honest risk tier, mutating actions are gated behind explicit approval, external input is validated at the boundary, and scheduled runs get a per-workflow auto-approve policy you set.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Jazz",
    operatingSystem: "macOS, Linux, Windows",
    applicationCategory: "DeveloperApplication",
    description:
      "Open-source AI agent CLI that runs on your own machine — terminal, Telegram, Discord, CI, cron. It asks before touching anything real. Works with 18 LLM providers including fully local models.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/licenses/MIT",
    url: "https://github.com/lvndry/jazz",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Base
  title="Jazz — open-source AI agent CLI that runs on your own machine"
  description="Jazz is a free, open-source AI agent that works while you don't. It triages your inbox, runs research, watches PRs, and reports back on terminal, Telegram, Discord, CI, or cron — on your own machine, asking before it touches anything real. Works with 18 LLM providers including fully local models via Ollama. MIT licensed."
  skin="dark"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <noscript>
    <style is:inline>
      /* Without JS every scene holds its finished frame — nothing is blank. */
      .approval,
      .fan .frame {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }
    </style>
  </noscript>
  <Hero />
  <Ticker />
  <InstallStrip />
  <SessionStage />
  <Surfaces />
  <UnderTheHood />
  <AsksFirst />
  <Cookbook />
  <section class="faq">
    <h2>Questions people actually ask</h2>
    {FAQ.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </section>
  <InstallCta />
</Base>

<style>
  .faq {
    max-width: 72ch;
    margin: 0 auto;
    padding: 60px 4vw;
  }
  h2 {
    font-size: 26px;
    letter-spacing: -0.01em;
    margin-bottom: 22px;
  }
  .faq-item {
    border-top: 1px solid var(--jz-border);
    padding: 14px 0;
  }
  summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--jz-selected);
  }
  summary:hover {
    color: var(--jz-primary);
  }
  .faq-item p {
    margin-top: 10px;
    color: var(--jz-info);
  }
</style>
