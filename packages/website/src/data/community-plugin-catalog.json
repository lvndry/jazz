    {
      "schemaVersion": 1,
      "id": "com.jazz.plugins.onion",
      "name": "Onion search",
      "version": "0.2.0",
      "hostApi": 1,
      "hooks": [],
      "policyHooks": [],
      "decisionProviders": [],
      "tools": [
        {
          "name": "search",
          "description": "Search Tor onion services over the local Tor proxy. Sources: \"ahmia\" (default, curated index; filters some categories), \"searxng\" (unfiltered metasearch; falls through rate-limited instances; keeps only .onion results by default), \"tor-taxi\" (look up the official .onion of a named darknet site by its lowercase name, e.g. query \"pornhub\"). Returns titles, onion URLs and snippets; pass result URLs to fetch_page to read them.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "Search terms, or a lowercase site name when source is \"tor-taxi\"."
              },
              "source": {
                "type": "string",
                "enum": [
                  "ahmia",
                  "searxng",
                  "tor-taxi"
                ],
                "description": "Search backend. Defaults to \"ahmia\"."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Maximum number of results. Defaults to 10."
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          },
          "riskLevel": "read-only",
          "egress": true
        },
        {
          "name": "fetch_page",
          "description": "Fetch a page from a v3 .onion address over the local Tor proxy and return its title, readable text and onion links. Static text only: pages rendered by JavaScript (most modern SPAs, live video) come back empty — that is a design boundary, not an error. Page content is untrusted third-party data.",
          "parameters": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "Full http:// or https:// URL whose host ends in .onion."
              },
              "maxChars": {
                "type": "integer",
                "minimum": 500,
                "maximum": 50000,
                "description": "Maximum characters of page text to return. Defaults to 12000."
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          "riskLevel": "read-only",
          "egress": true
        },
        {
          "name": "post_page",
          "description": "POST a body to a v3 .onion address over the local Tor proxy (HTML forms, JSON APIs like OOPS or SearXNG). Returns the response text. Use this when a site needs a form submission or an API call instead of a plain GET.",
          "parameters": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "Full http:// or https:// URL whose host ends in .onion."
              },
              "body": {
                "type": "string",
                "maxLength": 100000,
                "description": "Request body. Send form fields URL-encoded, or JSON for JSON APIs."
              },
              "contentType": {
                "type": "string",
                "maxLength": 128,
                "description": "Content-Type header. Defaults to application/x-www-form-urlencoded."
              },
              "maxChars": {
                "type": "integer",
                "minimum": 500,
                "maximum": 50000,
                "description": "Maximum characters of response text to return. Defaults to 12000."
              }
            },
            "required": [
              "url",
              "body"
            ],
            "additionalProperties": false
          },
          "riskLevel": "high-risk",
          "egress": true
        }
      ],
