{
  "$schema": "../theme.schema.json",
  "name": "kanagawa",
  "label": "Kanagawa",
  "description": "Kanagawa Wave for dark and Lotus for light. Syntax tints are tuned within hue to satisfy Jazz's distinctness laws.",
  "theme": {
    "background": {
      "dark": "#1f1f28",
      "light": "#f2ecbc"
    },
    "backgroundPanel": {
      "dark": "#181820",
      "light": "#e5ddb0"
    },
    "backgroundElement": {
      "dark": "#2a2a37",
      "light": "#d5cea3"
    },
    "borderSubtle": {
      "dark": "#2a2a37",
      "light": "#d5cea3"
    },
    "border": {
      "dark": "#363646",
      "light": "#c9cbd1"
    },
    "borderActive": {
