{
  "$schema": "../theme.schema.json",
  "name": "catppuccin",
  "label": "Catppuccin",
  "description": "Mocha for dark, Latte for light, under jazz's roles: mauve is the one accent, and strings take sapphire rather than Catppuccin's green so success green keeps a single meaning. Mocha is official throughout. Latte's green, yellow, pink, sapphire and lavender sit near 3:1 on its base and its blue just under 4.5:1, so each is darkened within its own hue until it clears 4.5:1; its ground, text ramp, mauve and red are official.",
  "defs": {
    "mochaBase": "#1e1e2e",
    "mochaMantle": "#181825",
    "mochaSurface0": "#313244",
    "mochaSurface1": "#45475a",
    "mochaSurface2": "#585b70",
    "mochaOverlay0": "#6c7086",
    "mochaSubtext0": "#a6adc8",
    "mochaText": "#cdd6f4",
    "mochaPink": "#f5c2e7",
    "mochaMauve": "#cba6f7",
    "mochaRed": "#f38ba8",
    "mochaPeach": "#fab387",
    "mochaYellow": "#f9e2af",
    "mochaGreen": "#a6e3a1",
    "mochaSapphire": "#74c7ec",
    "mochaLavender": "#b4befe",

    "latteBase": "#eff1f5",
    "latteMantle": "#e6e9ef",
    "latteCrust": "#dce0e8",
    "latteSurface0": "#ccd0da",
    "latteSurface1": "#bcc0cc",
    "latteOverlay2": "#7c7f93",
    "latteSubtext1": "#5c5f77",
    "latteText": "#4c4f69",
    "lattePinkDeep": "#9e4f89",
    "latteMauve": "#8839ef",
    "latteRed": "#d20f39",
    "latteYellowDeep": "#966010",
    "latteGreenDeep": "#307a22",
    "latteSapphireDeep": "#167586",
    "latteBlueDeep": "#1c60e7",
    "latteLavenderDeep": "#5464ba"
  },
  "theme": {
    "background": { "dark": "mochaBase", "light": "latteBase" },
    "backgroundPanel": { "dark": "mochaMantle", "light": "latteMantle" },
    "backgroundElement": { "dark": "mochaSurface0", "light": "latteCrust" },
    "borderSubtle": { "dark": "mochaSurface0", "light": "latteSurface0" },
    "border": { "dark": "mochaSurface1", "light": "latteSurface1" },
    "borderActive": { "dark": "mochaSurface2", "light": "latteOverlay2" },
    "selected": { "dark": "mochaText", "light": "latteText" },
    "secondary": { "dark": "mochaSubtext0", "light": "latteSubtext1" },
    "muted": { "dark": "mochaOverlay0", "light": "latteOverlay2" },
    "primary": { "dark": "mochaMauve", "light": "latteMauve" },
    "accentDim": { "dark": "mochaLavender", "light": "latteLavenderDeep" },
    "success": { "dark": "mochaGreen", "light": "latteGreenDeep" },
    "warning": { "dark": "mochaYellow", "light": "latteYellowDeep" },
    "error": { "dark": "mochaRed", "light": "latteRed" },
    "syntaxStructure": { "dark": "mochaPink", "light": "lattePinkDeep" },
    "syntaxValue": { "dark": "mochaSapphire", "light": "latteSapphireDeep" },
    "syntaxType": { "dark": "mochaPeach", "light": "latteBlueDeep" }
  }
}
