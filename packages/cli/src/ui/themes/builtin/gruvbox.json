{
  "$schema": "../theme.schema.json",
  "name": "gruvbox",
  "label": "Gruvbox",
  "description": "Gruvbox medium dark and light palettes. Error, warning and the accent are separated within the red/orange/yellow family so Jazz's distinctness laws hold.",
  "theme": {
    "background": {
      "dark": "#282828",
      "light": "#fbf1c7"
    },
    "backgroundPanel": {
      "dark": "#3c3836",
      "light": "#ebdbb2"
    },
    "backgroundElement": {
      "dark": "#504945",
      "light": "#d5c4a1"
    },
    "borderSubtle": {
      "dark": "#504945",
      "light": "#d5c4a1"
    },
    "border": {
      "dark": "#665c54",
      "light": "#bdae93"
    },
    "borderActive": {
      "dark": "#7c6f64",
      "light": "#a89984"
    },
    "selected": {
      "dark": "#ebdbb2",
      "light": "#3c3836"
    },
    "secondary": {
      "dark": "#bdae93",
      "light": "#665c54"
    },
    "muted": {
      "dark": "#a89984",
      "light": "#7c6f64"
