{
  "$schema": "../theme.schema.json",
  "name": "jazz",
  "label": "Jazz",
  "description": "The house theme: a neutral grey ramp and one accent. Dark's cyan sits on an exact xterm cube vertex (45), so it is byte-identical over SSH; on paper it darkens to a teal that still carries contrast. Success is a true green, clear of every syntax tint, so it keeps one meaning; inline code is rose (plum on paper) so it never reads as the warning amber.",
  "defs": {
    "ink": { "color": "#0a0a0a", "xterm": 232 },
    "inkPanel": { "color": "#141414", "xterm": 233 },
    "inkElement": { "color": "#1e1e1e", "xterm": 234 },
    "inkRuleSubtle": { "color": "#282828", "xterm": 235 },
    "inkRule": { "color": "#3c3c3c", "xterm": 237 },
    "inkRuleActive": { "color": "#606060", "xterm": 241 },
    "inkText": 255,
    "inkTextSecondary": 248,
    "inkTextMuted": 244,
    "cyan": 45,
    "cyanDeep": 38,
    "green": 78,
    "amber": 179,
    "coral": { "color": "#ff6b6b", "xterm": 203 },
    "violet": { "color": "#9b8cff", "xterm": 105 },
    "rose": 175,
    "steel": { "color": "#92b4c8", "xterm": 110 },

    "paper": 231,
    "paperPanel": "#fafafa",
    "paperElement": { "color": "#f3f3f3", "xterm": 255 },
    "paperRuleSubtle": "#ededed",
    "paperRule": "#e4e4e4",
    "paperRuleActive": { "color": "#b8b8b8", "xterm": 250 },
    "paperText": { "color": "#1a1a1a", "xterm": 234 },
    "paperTextSecondary": { "color": "#555555", "xterm": 240 },
    "paperTextMuted": { "color": "#8a8a8a", "xterm": 245 },
    "teal": { "color": "#00718f", "xterm": 31 },
    "tealDeep": 24,
    "forest": { "color": "#116b3e", "xterm": 29 },
    "ochre": { "color": "#8a5f00", "xterm": 94 },
    "brick": { "color": "#b3261e", "xterm": 124 },
    "indigo": { "color": "#5b3fbf", "xterm": 61 },
    "plum": { "color": "#9b2c6f", "xterm": 126 },
    "denim": { "color": "#2f6690", "xterm": 24 }
  },
  "theme": {
    "background": { "dark": "ink", "light": "paper" },
    "backgroundPanel": { "dark": "inkPanel", "light": "paperPanel" },
    "backgroundElement": { "dark": "inkElement", "light": "paperElement" },
    "borderSubtle": { "dark": "inkRuleSubtle", "light": "paperRuleSubtle" },
    "border": { "dark": "inkRule", "light": "paperRule" },
    "borderActive": { "dark": "inkRuleActive", "light": "paperRuleActive" },
    "selected": { "dark": "inkText", "light": "paperText" },
    "secondary": { "dark": "inkTextSecondary", "light": "paperTextSecondary" },
    "muted": { "dark": "inkTextMuted", "light": "paperTextMuted" },
    "primary": { "dark": "cyan", "light": "teal" },
    "accentDim": { "dark": "cyanDeep", "light": "tealDeep" },
    "success": { "dark": "green", "light": "forest" },
    "warning": { "dark": "amber", "light": "ochre" },
    "error": { "dark": "coral", "light": "brick" },
    "syntaxStructure": { "dark": "violet", "light": "indigo" },
    "syntaxValue": { "dark": "rose", "light": "plum" },
    "syntaxType": { "dark": "steel", "light": "denim" }
  }
}
