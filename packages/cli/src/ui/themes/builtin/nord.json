    "success": {
      "dark": "#a3be8c",
      "light": "#3d5e2a"
    },
    "syntaxStructure": {
      "dark": "#72adc7",
      "light": "#724268"
    },
    "syntaxValue": {
      "dark": "#d08770",
      "light": "#8b3a6f"
    },
    "syntaxType": {
      "dark": "#a8c8e3",
      "light": "#1a6b7a"
    },
    "accentDim": {
      "dark": "#c295b4",
      "light": "#8b3a6f"
    }
  }
}
