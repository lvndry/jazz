{
  "$schema": "../theme.schema.json",
  "name": "nord",
  "label": "Nord",
  "description": "Nord's Polar Night and Snow Storm palettes. Aurora and Frost hues are darkened for light mode and separated within their families so every semantic color clears Jazz's contrast and distinctness laws.",
  "theme": {
    "background": {
      "dark": "#2e3440",
      "light": "#eceff4"
    },
    "backgroundPanel": {
      "dark": "#3b4252",
      "light": "#e5e9f0"
    },
    "backgroundElement": {
      "dark": "#434c5e",
      "light": "#d8dee9"
    },
    "borderSubtle": {
      "dark": "#3b4252",
      "light": "#e5e9f0"
    },
    "border": {
      "dark": "#434c5e",
      "light": "#d8dee9"
    },
    "borderActive": {
      "dark": "#4c566a",
      "light": "#a8b0be"
    },
    "selected": {
      "dark": "#eceff4",
      "light": "#2e3440"
    },
    "secondary": {
      "dark": "#d8dee9",
      "light": "#3b4252"
    },
    "muted": {
      "dark": "#7b8794",
      "light": "#5c6779"
    },
    "primary": {
      "dark": "#81a1c1",
      "light": "#35607d"
    },
    "warning": {
