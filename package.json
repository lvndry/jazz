{
  "name": "jazz-ai",
  "version": "0.16.19",
  "author": {
    "name": "lvndry",
    "email": "lvndry@proton.me",
    "url": "https://github.com/lvndry"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvndry/jazz.git"
  },
  "bugs": {
    "url": "https://github.com/lvndry/jazz/issues"
  },
  "description": "An everyday AI assistant you can leave running: in your terminal, on a schedule, and in your chat apps.",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "homepage": "https://github.com/lvndry/jazz",
  "keywords": [
    "cli",
    "agents",
    "automation",
    "agentic",
    "typescript",
    "effect-ts",
    "ai",
    "llm",
    "workflow",
    "email",
    "git",
    "productivity",
    "assistant",
    "task-automation",
    "developer-tools",
    "ai-assistant",
    "ai-agent",
    "mcp",
    "mcp-server",
    "agent-skills"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:binary": "bun run scripts/build.ts --compile",
    "build:binaries": "bun run scripts/build.ts --compile --all-targets",
    "bundle:size": "bun run scripts/bundle-size.ts",
    "record:startup-order": "bun run scripts/record-startup-order.ts",
    "plugin:pack": "bun run scripts/plugin-pack.ts",
    "plugin:catalog": "bun run scripts/build-plugin-catalog.ts",
    "plugin:community-catalog": "bun run scripts/build-community-plugin-catalog.ts",
    "stage-npm-packages": "bun run scripts/build.ts --compile --all-targets --npm-packages",
    "typecheck": "bun run tsc -b tsconfig.json",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "evals": "bun run evals/cli.ts",
    "dev": "bun --watch packages/runtime/src/main.ts",
    "cli": "bun packages/runtime/src/main.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "bun eslint packages plugins scripts --cache --cache-strategy content --no-error-on-unmatched-pattern",
    "lint:fix": "bun eslint packages plugins scripts --fix --cache --cache-strategy content",
    "format": "bun prettier --write packages docs",
    "format:check": "bun prettier --check --log-level warn \"**/*.{ts,tsx,md}\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "bench": "bun bench/run.ts",
    "docs:config-reference": "bun run scripts/gen-config-reference.ts",
    "docs:check-links": "bun run scripts/check-docs-links.ts",
    "docs:check-metadata": "bun run scripts/check-docs-metadata.ts",
    "docs:chat-commands": "bun run packages/cli/src/chat/commands/generate-reference.ts",
    "docs:design": "bun run scripts/gen-design-docs.ts",
    "docs:lint": "bunx markdownlint-cli2",
    "docs:lint:fix": "bunx markdownlint-cli2 --fix",
    "test:typecheck": "bunx tsc --project tsconfig.test.json",
    "clean": "rm -rf deploy/binaries deploy/npm/jazz-ai-*/bin .build .tsbuild .tsbuildinfo .tsbuildinfo.scripts packages/*/dist packages/*/.tsbuildinfo",
    "test:e2e": "bun scripts/e2e/run-e2e.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "marked": "^18.0.14",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4"
  },
  "devDependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@ai-sdk/alibaba": "^2.0.69",
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/cerebras": "^3.0.71",
    "@ai-sdk/deepseek": "^3.0.67",
    "@ai-sdk/fireworks": "^3.0.74",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/groq": "^4.0.63",
    "@ai-sdk/mistral": "^4.0.66",
    "@ai-sdk/moonshotai": "^3.0.71",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/provider-utils": "^5.0.62",
    "@ai-sdk/togetherai": "^3.0.72",
    "@ai-sdk/xai": "^5.0.24",
    "@effect/platform-node": "^4.0.5",
    "@eslint/js": "^10.0.1",
    "@jazz/adapters": "workspace:*",
    "@jazz/core": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "@perplexity-ai/perplexity_ai": "^0.39.0",
    "@types/bun": "^1.4.3",
    "@types/marked": "^6.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@xterm/headless": "^6.0.0",
    "ai": "^7.0.143",
    "bun-types": "^1.4.3",
    "chalk": "^6.0.1",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.32.0",
    "diff": "^9.0.0",
    "effect": "^4.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.7",
    "exa-js": "^2.25.0",
    "fast-glob": "^3.3.3",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "gpt-tokenizer": "^4.0.3",
    "gray-matter": "^4.0.3",
    "ink": "^8.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "linkup-sdk": "^3.7.1",
    "marked": "^18.1.1",
    "node-emoji": "^2.2.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "parallel-web": "^1.3.5",
    "pdf-parse": "^2.4.5",
    "plist": "^5.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "semver": "^7.8.5",
    "short-uuid": "^6.0.3",
    "spectrum-ts": "^12.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "tz-lookup": "^6.1.25",
    "undici": "^8.12.2",
    "vercel-minimax-ai-provider": "^0.0.2",
    "wrap-ansi": "^10.0.2",
    "zhipu-ai-provider": "^0.4.0",
    "zod": "^4.6.7"
  }
}
