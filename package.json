    "@ai-sdk/moonshotai": "^3.0.58",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/provider-utils": "^5.0.49",
    "@ai-sdk/togetherai": "^3.0.58",
    "@ai-sdk/xai": "^5.0.10",
    "@effect/cluster": "^0.60.2",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/rpc": "^0.76.2",
    "@effect/sql": "^0.52.1",
    "@effect/workflow": "^0.19.1",
    "@eslint/js": "^10.0.1",
    "@jazz/adapters": "workspace:*",
    "@modelcontextprotocol/client": "^2.1.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "@perplexity-ai/perplexity_ai": "^0.38.6",
    "@types/bun": "^1.4.2",
    "@types/marked": "^6.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
