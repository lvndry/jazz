    "ai": "^7.0.118",
    "bun-types": "^1.4.2",
    "chalk": "^6.0.1",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "diff": "^9.0.0",
    "effect": "^3.22.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-prettier": "^5.5.6",
