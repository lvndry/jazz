{
  "name": "jazz-ai",
  "version": "0.15.43",
  "author": {
    "name": "lvndry",
    "email": "lvndry@proton.me",
    "url": "https://github.com/lvndry"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvndry/jazz.git"
  },
  "bugs": {
    "url": "https://github.com/lvndry/jazz/issues"
  },
  "description": "One agent. Every surface. Your rules.",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "homepage": "https://github.com/lvndry/jazz",
  "keywords": [
    "cli",
    "agents",
    "automation",
    "agentic",
    "typescript",
    "effect-ts",
    "ai",
    "llm",
    "workflow",
    "email",
    "git",
    "productivity",
    "assistant",
    "task-automation",
    "developer-tools",
    "ai-assistant",
    "ai-agent",
    "mcp",
    "mcp-server",
    "agent-skills"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:binary": "bun run scripts/build.ts --compile",
    "build:binaries": "bun run scripts/build.ts --compile --all-targets",
    "plugin:pack": "bun run scripts/plugin-pack.ts",
    "plugin:catalog": "bun run scripts/build-plugin-catalog.ts",
    "plugin:community-catalog": "bun run scripts/build-community-plugin-catalog.ts",
    "stage-npm-packages": "bun run scripts/build.ts --compile --all-targets --npm-packages",
    "typecheck": "bun run tsc -b tsconfig.json",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "evals": "bun run evals/cli.ts",
    "dev": "bun --watch packages/runtime/src/main.ts",
    "cli": "bun packages/runtime/src/main.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "bun eslint packages plugins scripts --cache --cache-strategy content --no-error-on-unmatched-pattern",
    "lint:fix": "bun eslint packages plugins scripts --fix --cache --cache-strategy content",
    "format": "bun prettier --write packages docs",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "bench": "bun bench/run.ts",
    "docs:check-links": "bun run scripts/check-docs-links.ts",
    "docs:check-metadata": "bun run scripts/check-docs-metadata.ts",
    "docs:design": "bun run scripts/gen-design-docs.ts",
    "docs:lint": "bunx markdownlint-cli2",
    "docs:lint:fix": "bunx markdownlint-cli2 --fix",
    "test:typecheck": "bunx tsc --project tsconfig.test.json",
    "clean": "rm -rf deploy/binaries deploy/npm/jazz-ai-*/bin .build .tsbuild .tsbuildinfo .tsbuildinfo.scripts packages/*/dist packages/*/.tsbuildinfo"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4"
  },
  "devDependencies": {
    "@a2a-js/sdk": "^1.2.1",
    "@ai-sdk/alibaba": "^2.0.56",
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/cerebras": "^3.0.57",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/fireworks": "^3.0.60",
    "@ai-sdk/google": "^4.0.82",
