    "marked-terminal": "^7.3.0",
    "node-emoji": "^2.2.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "parallel-web": "^1.3.3",
    "pdf-parse": "^2.4.5",
    "plist": "^5.0.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.0",
    "semver": "^7.8.5",
    "short-uuid": "^6.0.3",
    "spectrum-ts": "^12.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "tz-lookup": "^6.1.25",
    "undici": "^8.11.2",
    "vercel-minimax-ai-provider": "^0.0.2",
