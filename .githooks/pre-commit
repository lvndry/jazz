#!/bin/sh
# `bun install` points core.hooksPath here on every checkout, CI runners included.
if ! command -v pre-commit >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    exit 0
  fi
  echo "pre-commit is not installed or its install is broken. Run: uv tool install --force pre-commit" >&2
  exit 1
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

pre-commit run --hook-stage pre-commit
exit_code=$?

# Formatters exit 1 after fixing files; re-stage only what was staged, then retry once.
if [ $exit_code -ne 0 ]; then
  printf '%s\n' "$staged_files" | while IFS= read -r staged_file; do
    if [ -n "$staged_file" ]; then
      git add -- "$staged_file"
    fi
  done
  pre-commit run --hook-stage pre-commit
  exit_code=$?
fi

exit $exit_code
