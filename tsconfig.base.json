{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "paths": {
      "@/core/*": ["./packages/core/src/*"],
      "@/adapters/*": ["./packages/adapters/src/*"],
      "@/cli/*": ["./packages/cli/src/*"],
      "@/runtime/*": ["./packages/runtime/src/*"],
      "@/bot-shared/*": ["./packages/bot-shared/src/*"],
      "@/discord-bot/*": ["./packages/discord-bot/src/*"],
      "@/imessage-bot/*": ["./packages/imessage-bot/src/*"],
      "@/photon-bot/*": ["./packages/photon-bot/src/*"],
      "@/telegram-bot/*": ["./packages/telegram-bot/src/*"],
      "@/whatsapp-bot/*": ["./packages/whatsapp-bot/src/*"]
    },

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "strict": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "removeComments": true,
    "allowJs": false,
    "checkJs": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",

    // Pinned so every project (app, build, test) resolves the same globals;
    // auto-included @types gave the app program laxer fetch/env typings than
    // the pinned test program, forcing per-site eslint-disable comments.
    "types": ["bun", "node"]
  }
}
