# Copy to .env and fill in. Never commit the real .env.

# --- Telegram ---
# Bot token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to use the bot. Required — the bot
# ignores everyone else. DM @userinfobot to find your id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Transport: polling (default) or webhook.
#   polling — bridge long-polls getUpdates; no public endpoint needed.
#   webhook — Telegram POSTs to a public URL (requires the two vars below).
TELEGRAM_MODE=polling

# Only needed when TELEGRAM_MODE=webhook.
# TELEGRAM_WEBHOOK_SECRET=   # openssl rand -hex 32
# TELEGRAM_WEBHOOK_URL=      # https://<host>.<tailnet>.ts.net/telegram/webhook

# --- Model ---
# Provider + model the agent uses. Any provider Jazz supports works, e.g.:
#   openai      + gpt-5.4                 (default)
#   openrouter  + anthropic/claude-...     (or any OpenRouter model id)
#   anthropic   + claude-...
#   groq / mistral / deepseek / xai / ... + their model ids
#   ollama      + <locally pulled model>   (see the Ollama section below)
JAZZ_TELEGRAM_PROVIDER=openai
JAZZ_TELEGRAM_MODEL=gpt-5.4

# Set the API key for your chosen provider (only one is needed). The bridge
# passes the whole .env to Jazz, which reads the standard provider env var.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# --- Web search (optional) ---
# Brave Search API key. If set, the agent's web_search tool uses Brave.
# BRAVE_API_KEY=

# Reasoning effort: disable | low | medium | high. Reasoning-capable models
# (gpt-5.4, qwen3, …) can use medium/high; models without it (mistral-small,
# gemma, …) 400 unless this is "disable".
JAZZ_REASONING=medium

# --- Local models via Ollama (optional) ---
# To use local models instead, set the two above to e.g.:
#   JAZZ_TELEGRAM_PROVIDER=ollama
#   JAZZ_TELEGRAM_MODEL=qwen3.6:27b
# and point the bridge at your Ollama (host.docker.internal reaches the host's
# published 11434). A missing Ollama model surfaces as "Not Found".
OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Auto-approve tools up to this risk level: read-only | low-risk | high-risk.
JAZZ_APPROVAL_POLICY=low-risk

# Per-message agent run timeout, milliseconds.
JAZZ_RUN_TIMEOUT_MS=300000

# Host port the /health server listens on.
PORT=8080
