# Copy to .env and fill in. Never commit the real .env.

# --- Discord ---
# Bot token from the Discord developer portal (Bot tab → Reset Token). Required.
DISCORD_BOT_TOKEN=

# Allowlists — at least one is required. Snowflakes, comma-separated.
#   USER ids    — DMs from these people, and (if no channel/guild list) their
#                 @mentions in any server the bot is in.
#   CHANNEL ids — guild channels (and their threads) the bot will answer in.
#   GUILD ids   — whole servers (still mention-gated unless you turn that off).
DISCORD_ALLOWED_USER_IDS=
# DISCORD_ALLOWED_CHANNEL_IDS=
# DISCORD_ALLOWED_GUILD_IDS=

# In servers, only respond when mentioned, when replied-to, or in a thread the
# bot already joined. DMs always respond. Set 0 to answer every message in an
# allowlisted channel (noisy, expensive).
DISCORD_REQUIRE_MENTION=1

# When @mentioned in a server channel, start a thread and keep the conversation
# there. Set 0 to reply in the channel instead.
DISCORD_CREATE_THREADS=1

# Public HTTPS origin this bridge is reachable at, used for create_web_app's
# "interactive" mode (a link is posted). Leave unset to disable interactive
# web apps (the static/image mode still works). Add a `ports:` mapping in
# docker-compose.yml if you set this.
# DISCORD_PUBLIC_BASE_URL=  # https://<host>.<tailnet>.ts.net

# --- Model ---
# Provider + model the agent uses. Any provider Jazz supports works, e.g.:
#   openai      + gpt-5.4                 (default)
#   openrouter  + anthropic/claude-...
#   ollama      + <locally pulled model>
JAZZ_DISCORD_PROVIDER=openai
JAZZ_DISCORD_MODEL=gpt-5.4

# Set the API key for your chosen provider (only one is needed).
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# BRAVE_API_KEY=

# --- Local Ollama (optional) ---
# How long Ollama keeps the model loaded (`keep_alive`): "-1" pins it
# indefinitely, or a duration like "30m". Unset uses Ollama's 5-minute default,
# which means the first message after a quiet spell pays a full cold model load
# — minutes on a CPU-bound host, with no progress shown while it happens.
# JAZZ_OLLAMA_KEEP_ALIVE=-1

# Reasoning effort: disable | low | medium | high.
JAZZ_REASONING=medium

# --- Local models via Ollama (optional) ---
# JAZZ_DISCORD_PROVIDER=ollama
# JAZZ_DISCORD_MODEL=qwen3.6:27b
OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Auto-approve tools up to this risk level: read-only | low-risk | high-risk.
JAZZ_APPROVAL_POLICY=low-risk

# Comma-separated tool names to auto-approve regardless of policy.
# JAZZ_AUTO_APPROVE_TOOLS=

# Daily spend ceiling in USD across all conversations. 0 disables the cap.
# JAZZ_DAILY_COST_CAP_USD=0

# Per-message agent run timeout, milliseconds.
JAZZ_RUN_TIMEOUT_MS=300000

PORT=8080

# Fallback timezone for reminder times when a channel hasn't set its own via /tz.
# TZ=UTC
